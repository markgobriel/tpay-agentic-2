# Copy to .env when running the app against a local Elastic APM stack.
# Start the stack with: npm run observability:up

ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=home-rhythm
ELASTIC_APM_ENVIRONMENT=local

# Only needed when APM Server auth is enabled.
# ELASTIC_APM_SECRET_TOKEN=

PORT=4173
HOME_RHYTHM_DATA_FILE=data/routines.json
