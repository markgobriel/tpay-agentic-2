{
  "name": "home-rhythm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "node scripts/format-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run build && npm run architecture:check && npm run test",
    "status": "node scripts/status.mjs",
    "autonomous": "sh scripts/run-autonomous.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
