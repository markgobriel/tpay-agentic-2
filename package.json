{
  "name": "home-rhythm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/web/index.html dist/index.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "node scripts/format-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "validate": "npm run format:check && npm run typecheck && npm run build && npm run architecture:check && npm run test",
    "status": "node scripts/status.mjs",
    "activity": "node scripts/activity.mjs",
    "autonomous": "bash scripts/run-autonomous.sh",
    "dev": "npm run build && node scripts/dev.mjs",
    "observability:up": "docker compose up --build",
    "observability:stack": "docker compose up elasticsearch kibana apm-server -d",
    "observability:down": "docker compose down"
  },
  "dependencies": {
    "elastic-apm-node": "^4.11.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
